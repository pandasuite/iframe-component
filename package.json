{
  "name": "iframe-component",
  "version": "1.0.2",
  "main": "index.js",
  "repository": "https://github.com/pandasuite/iframe-component.git",
  "private": true,
  "scripts": {
    "start": "webpack-dev-server --open",
    "build": "rm -f ./pandasuite-component.zip ./iframe-component-v*.zip && webpack --mode production --devtool none && cd build && zip -r -X \"../iframe-component-v$npm_package_version.zip\" *",
    "release": "release-it --no-npm.publish"
  },
  "devDependencies": {
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^6.0.2",
    "eslint": "^7.2.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-plugin-import": "^2.21.2",
    "release-it": "^13.6.3",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "pandasuite-bridge": "^4.2.1"
  },
  "release-it": {
    "hooks": {
      "after:bump": "yarn build"
    },
    "github": {
      "release": true,
      "assets": [
        "iframe-component-v*.zip"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "IE >= 9",
      "Android > 0",
      "iOS > 0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
